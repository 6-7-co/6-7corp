# Copy to `.env` (local) or paste into your host's environment settings.

# ---------------------------------------------------------------- database ---
# Postgres (Neon). Leave empty locally to use SQLite in server/data/app.db.
# Neon → Dashboard → Connect → copy the "pooled" connection string.
# DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------- auth ----
# JWT signing secret — MUST be at least 32 chars in production.
JWT_SECRET=change-me-to-a-long-random-secret-please-32+

# Session lifetime in days
SESSION_DAYS=14

# First-run / seed admin account
ADMIN_USER=admin
ADMIN_PASSWORD=admin12345

# ------------------------------------------------------------------- misc ----
# Server bind (ignored on Vercel)
HOST=0.0.0.0
PORT=3001

# Comma-separated list of allowed CORS origins, or omit for any (dev).
# Not needed when the site and the API share a domain (Vercel, Docker).
# CLIENT_ORIGIN=http://localhost:5173

# -------------------------------------------------------------- admin path ---
# Hidden admin panel path (client build-time value, no leading slash).
# The panel is never linked from the public site — only this URL opens it.
VITE_ADMIN_PATH=studio-6-7

# --------------------------------------------------------------- uploads ----
# Vercel Blob token (auto-added by the Vercel Blob integration). When present,
# images are stored in Blob; otherwise they go to server/uploads.
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx
